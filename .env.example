# Client (optional — default uses /api/search on same domain)
VITE_API_SEARCH_PATH=/api/search

# Netlify server — set in Netlify dashboard → Site settings → Environment variables
# If PAKISTAN_DB_API_URL is set, /api/search proxies to your external Pakistan database API.
# If empty, /api/search searches the bundled public/pakistan-database.json index.
PAKISTAN_DB_API_URL=
PAKISTAN_DB_API_KEY=
